{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "superforecaster",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "api.main:app", "--port", "8099"],
      "cwd": "backend",
      "port": 8099
    },
    {
      "name": "superforecaster-runs",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_PATH=./superforecaster/superforecaster.db",
        "uv",
        "run",
        "uvicorn",
        "api.main:app",
        "--port",
        "8098"
      ],
      "cwd": "backend",
      "port": 8098
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5199"],
      "cwd": "frontend",
      "port": 5199
    }
  ]
}
