# Backend (API + agents)
ADMIN_API_KEY=changeme

# LLM — use ONE of these:
# Option A (recommended): Logfire Gateway key from
# https://logfire.pydantic.dev → your org → Gateway → API keys
# Legacy paig_... keys from gateway.pydantic.dev no longer work.
PYDANTIC_AI_GATEWAY_API_KEY=

# Option B: Direct Anthropic API (bypasses the gateway)
# ANTHROPIC_API_KEY=

# Optional override for all three agents
# AGENT_MODEL=gateway/anthropic:claude-sonnet-4-6
# AGENT_REQUEST_LIMIT=40
# AGENT_TOOL_CALLS_LIMIT=20

TAVILY_API_KEY=
# Optional: project write token for Logfire cloud traces (pylf_v1_us_...), NOT the gateway key
# LOGFIRE_TOKEN=

# Refresh / scheduler config
REFRESH_CRON_SCHEDULE=0 6 * * *
DIGEST_CRON_SCHEDULE=0 9 28-31 * *
MIN_PROBABILITY_DELTA=0.03
SEARCH_LOOKBACK_HOURS=48

# DB path (Docker uses /app/data; local dev uses ./superforecaster.db)
DATABASE_PATH=./superforecaster.db
